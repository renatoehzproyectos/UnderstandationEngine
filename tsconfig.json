{
  "compilerOptions": {
    "target": "ES2020", "lib": ["ES2020", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "bundler", "jsx": "react-jsx", "strict": true, "skipLibCheck": true,
    "resolveJsonModule": true, "isolatedModules": true, "noEmit": true, "baseUrl": ".",
    "paths": { "@engine/*": ["engine/*/src"], "@library/*": ["knowledge-library/*"] }
  },
  "include": ["apps/web/src", "engine", "knowledge-library"]
}
